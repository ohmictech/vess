# Escrow Covenant
#
# A two-party escrow that locks funds until a timelock expires.
# The seller can withdraw after `release_at`. Both buyer and seller
# must approve the initial deposit via linked guard programs.
#
# Usage:
#   vess deploy ./escrow.vess --name +vl_escrow1
#   vess send 100 +vl_escrow1    # Deposit
#   # Wait for release_at, then seller claims

[constants]
# Unix timestamp after which the seller can withdraw
u64 release_at = 1750000000
# Maximum single deposit amount
u64 max_deposit = 500
# Emergency pause (set to true to freeze all operations)
bool paused = false

[links]
# Linked programs that must approve deposits/withdrawals
buyer_guard
seller_guard

[deposit]
require !paused
require amount <= max_deposit
# Both buyer and seller guard programs must approve
require all_of(buyer_guard, seller_guard)
bind locked_until = release_at
approve

[withdraw]
require !paused
# Cannot withdraw before the timelock
require after(release_at)
# Seller guard must approve the withdrawal
require satisfies(seller_guard)
bind released = requested
approve
