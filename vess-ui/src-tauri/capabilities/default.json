{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "default permissions for Vess wallet",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:982*/**" },
        { "url": "http://127.0.0.1:983*/**" },
        { "url": "http://127.0.0.1:984*/**" },
        { "url": "http://127.0.0.1:985*/**" },
        { "url": "http://localhost:5173/**" }
      ]
    }
  ]
}
