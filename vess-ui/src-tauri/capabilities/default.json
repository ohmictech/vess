{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions plus HTTP for node RPC",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "http:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:9821/**" },
        { "url": "http://localhost:9821/**" },
        { "url": "http://127.0.0.1:5173/**" }
      ]
    }
  ]
}
