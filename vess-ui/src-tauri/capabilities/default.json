{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions plus HTTP for node RPC",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "http:default",
    "shell:allow-spawn",
    "shell:allow-execute",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://127.0.0.1:982*/**" },
        { "url": "http://127.0.0.1:983*/**" },
        { "url": "http://127.0.0.1:984*/**" },
        { "url": "http://127.0.0.1:985*/**" },
        { "url": "http://localhost:5173/**" }
      ]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "vess-artery",
          "sidecar": true
        }
      ]
    }
  ]
}
